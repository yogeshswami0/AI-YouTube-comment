# =============================================================================
# ReplyPilot — Consolidated Docker Environment Template
# =============================================================================
# Copy this file and fill in real values:
#   cp .env.docker .env.docker.local
#
# Then run:
#   docker compose --env-file .env.docker.local up --build
#
# ⚠ NEVER commit .env.docker.local to version control!
# =============================================================================

# ─── Client (build-time arg baked into React bundle) ─────────────────────────
# In Docker, the client talks to the server via Nginx proxy on /api/*
# so this should point to your public-facing server URL or just leave empty
# to let Nginx proxy handle it internally.
VITE_API_URL=http://localhost:5000
