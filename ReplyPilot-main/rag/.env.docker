# =============================================================================
# rag/.env.docker — Environment for Docker deployment
# =============================================================================
# ⚠ Fill in real values. NEVER commit this file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=rag
APP_VERSION=1.0.0
DEBUG=false

# ── Redis Cloud (cloud) ───────────────────────────────────────────────────────
REDIS_HOST=your_redis_cloud_hostname
REDIS_PORT=12764
REDIS_PASSWORD=your_redis_password
REDIS_USERNAME=default
REDIS_USE_TLS=false

# ── Pinecone (cloud) ──────────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=yt-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=768
PINECONE_METRIC=cosine

# ── Embedding ─────────────────────────────────────────────────────────────────
BGE_MODEL_NAME=BAAI/bge-base-en-v1.5
BGE_DEVICE=cpu
BGE_BATCH_SIZE=16

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=80
CONTEXT_PREFIX_SENTENCES=2

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.65
RERANKER_ENABLED=false
