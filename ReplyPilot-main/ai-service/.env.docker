# =============================================================================
# ai-service/.env.docker — Environment for Docker deployment
# =============================================================================
# ⚠ Fill in real values. NEVER commit this file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=False

# ── Allowed CORS origins (server + client containers) ─────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://server:5000,http://localhost:5000

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=your_huggingface_token
HF_CLASSIFIER_TOKEN=your_hf_classifier_token
HF_REPO_ID=Ashutosh12652/Intent_classification

# ── PyTorch JIT (disable for compatibility) ───────────────────────────────────
PYTORCH_JIT=0

# ── RAG Service — Docker internal DNS ─────────────────────────────────────────
RAG_SERVICE_URL=http://rag:8001

# ── Classification Thresholds ─────────────────────────────────────────────────
QUESTION_CONFIDENCE_THRESHOLD=0.4

# ── Redis Cloud (cloud) ───────────────────────────────────────────────────────
REDIS_HOST=your_redis_cloud_hostname
REDIS_PORT=12764
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_USE_TLS=True
