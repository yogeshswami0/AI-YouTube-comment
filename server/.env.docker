# =============================================================================
# server/.env.docker — Environment for Docker deployment
# =============================================================================
# ⚠ Fill in real values. NEVER commit this file to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Update this to your real domain / tunnel URL in production
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ── CORS — allow the client container ────────────────────────────────────────
CORS_WHITELIST=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── AI Service — Docker internal DNS ─────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000

# ── MongoDB Atlas (cloud) ────────────────────────────────────────────────────
MONGODB_URI=your_mongodb_atlas_connection_string

# ── Redis Cloud (cloud) ──────────────────────────────────────────────────────
REDIS_URL=your_redis_cloud_hostname
REDIS_PORT=12764
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_BULL_PREFIX=bull

# ── Secrets ───────────────────────────────────────────────────────────────────
SESSION_SECRET=your_session_secret_min_32_chars
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_min_32_chars

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key
